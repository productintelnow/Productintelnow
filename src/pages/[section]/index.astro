---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { sections } from '../../config/sections.mjs';
import { CONTENT_TYPE_LABELS } from '../../config/constants.mjs';
import { site } from '../../config/site';
import { breadcrumbLd } from '../../lib/structured.mjs';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return sections.map((section) => ({
    params: { section: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const articles = await getCollection('articles');
const matching = articles
  .filter((article) =>
    section.contentType
      ? article.data.content_type === section.contentType
      : article.data.category === section.category,
  )
  .sort((a, b) => a.data.content_id.localeCompare(b.data.content_id));
const published = matching.filter((article) => article.data.status === 'published');
const previews = matching.filter((article) => article.data.status !== 'published');
const crumbs = [
  { href: '/', label: 'Home' },
  { href: `/${section.slug}`, label: section.title },
];
---

<BaseLayout title={section.title} description={section.description} jsonLd={[breadcrumbLd(site.url, crumbs)]}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <p class="kicker">{section.kicker}</p>
    <h1>{section.title}</h1>
    <p class="lede">{section.description}</p>

    <section aria-labelledby="published-heading">
      <h2 id="published-heading">Published</h2>
      {
        published.length === 0 ? (
          <p>No published articles in this section yet. Real product pages land here after the records are verified and the owner approves them.</p>
        ) : (
          <ul class="article-list">
            {published.map((article) => (
              <li>
                <a href={`/${article.data.category}/${article.data.slug}`}>{article.data.title}</a>
                <p>{article.data.meta_description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      previews.length > 0 && (
        <section aria-labelledby="preview-heading">
          <h2 id="preview-heading">Template previews</h2>
          <p>These pages are samples. They use fictional products and are marked noindex.</p>
          <ul class="article-list">
            {previews.map((article) => (
              <li>
                <a href={`/${article.data.category}/${article.data.slug}`}>
                  <span class="badge">{article.data.status}</span>
                  {article.data.title}
                </a>
                <p>
                  {CONTENT_TYPE_LABELS[article.data.content_type]} · {article.data.meta_description}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
