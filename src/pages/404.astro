---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'That page is not on GarageIntel. Try a section from the menu or search the article index.';
---

<BaseLayout title="Page not found" description={description} noindex={true} contentStatus="missing">
  <div class="wrap">
    <p class="kicker">404</p>
    <h1>That page is not in the library.</h1>
    <p class="lede">{description}</p>
    <p><a href="/">Go to the home page</a> or <a href="/search">search articles</a>.</p>
  </div>
</BaseLayout>
