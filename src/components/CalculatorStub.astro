---
const { calculatorId } = Astro.props;
---

{
  calculatorId === 'shelf-bins' && (
    <section aria-labelledby="calc-heading">
      <h2 id="calc-heading">Sample shelf-bin count</h2>
      <form class="calc" data-calculator="shelf-bins">
        <p>Type both widths in the same unit. The result is how many whole bins fit. It is arithmetic, not a product pick.</p>
        <label>
          Clear shelf width
          <input name="shelf" type="number" min="0" step="0.1" inputmode="decimal" value="96" />
        </label>
        <label>
          Bin width, including any lip
          <input name="bin" type="number" min="0" step="0.1" inputmode="decimal" value="12" />
        </label>
        <p>
          Whole bins: <output data-bin-count>8</output>
        </p>
      </form>
    </section>
  )
}

<script>
  const form = document.querySelector('[data-calculator="shelf-bins"]');
  if (form instanceof HTMLFormElement) {
    const output = form.querySelector('[data-bin-count]');
    const update = () => {
      const data = new FormData(form);
      const shelf = Number(data.get('shelf'));
      const bin = Number(data.get('bin'));
      const count = bin > 0 && shelf >= 0 ? Math.floor(shelf / bin) : 0;
      if (output) output.textContent = Number.isFinite(count) ? String(count) : '0';
    };
    form.addEventListener('input', update);
    update();
  }
</script>
