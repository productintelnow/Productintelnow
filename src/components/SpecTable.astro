---
const { rows = [], caption = 'Specifications' } = Astro.props;
---

{
  rows.length > 0 && (
    <section>
      <h2>{caption}</h2>
      <table class="spec-table">
        <caption class="visually-hidden">{caption}</caption>
        <tbody>
          {rows.map((row: { label: string; value: string }) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )
}
