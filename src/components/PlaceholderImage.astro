---
import { getImage } from 'astro:assets';
import hero from '../assets/placeholders/hero-neutral.png';
import product from '../assets/placeholders/product-neutral.png';
import social from '../assets/placeholders/social-neutral.png';

const assets = {
  'placeholder:hero-neutral': hero,
  'placeholder:product-neutral': product,
  'placeholder:social-neutral': social,
};

interface Props {
  imageKey?: keyof typeof assets;
  alt: string;
  priority?: boolean;
}

const { imageKey = 'placeholder:hero-neutral', alt, priority = false } = Astro.props;
const width = imageKey === 'placeholder:product-neutral' ? 640 : 1200;
const height = imageKey === 'placeholder:product-neutral' ? 640 : 630;
const image = await getImage({
  src: assets[imageKey] ?? hero,
  width,
  height,
  format: 'webp',
});
---

<img
  src={image.src}
  width={image.attributes.width}
  height={image.attributes.height}
  alt={alt}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : 'auto'}
/>
