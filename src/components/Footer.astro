---
import { site } from '../config/site';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="wordmark">Garage<span>Intel</span></p>
      <p data-disclosure="footer">{site.disclosure}</p>
      <p>
        Operated by <span class="placeholder">{site.legalEntity}</span>.
        Mail: <span class="placeholder">{site.mailingAddress}</span>.
        Email: <span class="placeholder">{site.contactEmail}</span>.
      </p>
    </div>
    <ul class="footer-links">
      <li><a href="/about">About</a></li>
      <li><a href="/how-we-review">How we review</a></li>
      <li><a href="/affiliate-disclosure">Affiliate disclosure</a></li>
      <li><a href="/privacy">Privacy policy</a></li>
      <li><a href="/terms">Terms of use</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="/search">Search</a></li>
    </ul>
  </div>
</footer>
